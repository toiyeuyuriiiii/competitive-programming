{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run CP (C++)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/run_cp.ps1",
                "-src",
                "${file}",
                "-exe",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build C++ Debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++14",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-DLOCAL",
                "-D_GLIBCXX_DEBUG",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}_debug.exe"
            ],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}